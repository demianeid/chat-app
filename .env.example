# Copy this file to .env and fill in your values
# Get your Groq API key (free) from: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# Available models: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768 | gemma2-9b-it
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Get your Tavily API key (free) from: https://app.tavily.com
VITE_WEB_SEARCH_API_KEY=your_tavily_api_key_here

# Get your Gemini API key from: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-3.8-flash
